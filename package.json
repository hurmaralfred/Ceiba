{
  "name": "ceiba-app",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "audit:contracts": "node scripts/audit-contracts.mjs",
    "verify:baseline": "npm run audit:contracts && npm run typecheck && npm run build",
    "test": "vitest run",
    "cap:dev": "CAP_ENV=dev npx cap sync && npx cap open ios",
    "cap:sync": "npx cap sync",
    "cap:ios": "npx cap open ios",
    "cap:android": "npx cap open android"
  },
  "dependencies": {
